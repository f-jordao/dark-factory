{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Stage result envelope",
  "properties": {
    "demand_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "waiting",
        "stopped"
      ]
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_branch": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "demand_id",
    "repository",
    "head_sha",
    "base_sha",
    "scope_digest",
    "policy_version",
    "workflow_id",
    "stage_id",
    "status",
    "input_digest",
    "artifacts",
    "blocking_reason",
    "target_branch"
  ]
}
