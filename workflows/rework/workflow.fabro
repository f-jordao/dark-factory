// Generated from definition.json. Content and execution bindings are pending.
// Human selections are not authenticated approval records by themselves.
digraph Rework {
    graph [default_fidelity="full", default_max_retries=0, max_node_visits=3, on_failure="exit"]
    start [shape=Mdiamond, label="Start"]
    scaffold_guard [shape=parallelogram, label="Content pending — execution blocked", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", goal_gate=true, max_retries=0]
    exit [shape=Msquare, label="End / governed handoff"]
    context [shape=parallelogram, label="Collect failure and revision context", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    budget [shape=parallelogram, label="Read bounded repair budget", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    remaining [shape=diamond, label="Repair budget remaining?"]
    repair [shape=box, label="Repair within approved scope", backend="acp", acp.command="false", prompt="@../../stages/repair/prompt.md", timeout="12m", max_retries=0, max_visits=2]
    count [shape=parallelogram, label="Persist completed repair attempt", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    verify [shape=parallelogram, label="Hand off to shared workflow", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    passed [shape=diamond, label="Verification passed?"]
    reassess [shape=parallelogram, label="Hand off to shared workflow", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    review [shape=parallelogram, label="Hand off to shared workflow", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    escalate [shape=hexagon, label="Human decides after repair limit"]
    record [shape=parallelogram, label="Validate and record human decision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    new_demand [shape=parallelogram, label="Create a separate scoped demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    stopped [shape=parallelogram, label="Record stopped demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    start -> scaffold_guard
    scaffold_guard -> exit [label="Content pending"]
    scaffold_guard -> context [condition="outcome=succeeded"]
    context -> budget [condition="outcome=succeeded"]
    budget -> remaining [condition="outcome=succeeded"]
    remaining -> repair [label="Budget available", condition="context.repair_budget_remaining=true"]
    remaining -> escalate [label="Exhausted / unknown"]
    repair -> count [condition="outcome=succeeded"]
    count -> verify [condition="outcome=succeeded"]
    verify -> passed [condition="outcome=succeeded"]
    passed -> reassess [label="Passed", condition="context.verification_passed=true"]
    passed -> budget [label="Failed / missing evidence"]
    reassess -> review [condition="outcome=succeeded"]
    review -> exit [condition="outcome=succeeded"]
    escalate -> record [label="[A] Authorize a separate scoped demand"]
    escalate -> stopped [label="[S] Stop"]
    record -> new_demand [condition="outcome=succeeded"]
    new_demand -> exit [condition="outcome=succeeded"]
    stopped -> exit [condition="outcome=succeeded"]
    context -> exit [label="Failed / unanswered"]
    budget -> exit [label="Failed / unanswered"]
    repair -> exit [label="Failed / unanswered"]
    count -> exit [label="Failed / unanswered"]
    verify -> exit [label="Failed / unanswered"]
    reassess -> exit [label="Failed / unanswered"]
    review -> exit [label="Failed / unanswered"]
    escalate -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record -> exit [label="Failed / unanswered"]
    new_demand -> exit [label="Failed / unanswered"]
    stopped -> exit [label="Failed / unanswered"]
}
