// Generated from definition.json. Content and execution bindings are pending.
// Human selections are not authenticated approval records by themselves.
digraph Discovery {
    graph [default_fidelity="full", default_max_retries=0, max_node_visits=3, on_failure="exit"]
    start [shape=Mdiamond, label="Start"]
    scaffold_guard [shape=parallelogram, label="Content pending — execution blocked", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", goal_gate=true, max_retries=0]
    exit [shape=Msquare, label="End / governed handoff"]
    validate [shape=parallelogram, label="Validate demand and immutable inputs", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    investigate [shape=box, label="Investigate without changing code", backend="acp", acp.command="false", prompt="@../../stages/investigate/prompt.md", timeout="12m", max_retries=0]
    impact [shape=box, label="Explain reach and uncertainty", backend="acp", acp.command="false", prompt="@../../stages/analyze-impact/prompt.md", timeout="12m", max_retries=0]
    recommend [shape=box, label="Produce findings and alternatives", backend="acp", acp.command="false", prompt="@../../stages/recommend/prompt.md", timeout="12m", max_retries=0]
    decision [shape=hexagon, label="Authorize new demand, clarify or stop"]
    record_decision [shape=parallelogram, label="Validate and record human decision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    new_demand [shape=parallelogram, label="Create a separate scoped demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    stopped [shape=parallelogram, label="Record stopped demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    start -> scaffold_guard
    scaffold_guard -> exit [label="Content pending"]
    scaffold_guard -> validate [condition="outcome=succeeded"]
    validate -> investigate [condition="outcome=succeeded"]
    investigate -> impact [condition="outcome=succeeded"]
    impact -> recommend [condition="outcome=succeeded"]
    recommend -> decision [condition="outcome=succeeded"]
    decision -> record_decision [label="[A] Authorize a new scoped demand"]
    decision -> investigate [label="[R] Clarify"]
    decision -> stopped [label="[S] Stop"]
    record_decision -> new_demand [condition="outcome=succeeded"]
    new_demand -> exit [condition="outcome=succeeded"]
    stopped -> exit [condition="outcome=succeeded"]
    validate -> exit [label="Failed / unanswered"]
    investigate -> exit [label="Failed / unanswered"]
    impact -> exit [label="Failed / unanswered"]
    recommend -> exit [label="Failed / unanswered"]
    decision -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record_decision -> exit [label="Failed / unanswered"]
    new_demand -> exit [label="Failed / unanswered"]
    stopped -> exit [label="Failed / unanswered"]
}
