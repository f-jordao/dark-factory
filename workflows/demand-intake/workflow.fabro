// Generated from definition.json. Content and execution bindings are pending.
// Human selections are not authenticated approval records by themselves.
digraph DemandIntake {
    graph [default_fidelity="full", default_max_retries=0, max_node_visits=3, on_failure="exit"]
    start [shape=Mdiamond, label="Start"]
    scaffold_guard [shape=parallelogram, label="Content pending — execution blocked", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", goal_gate=true, max_retries=0]
    exit [shape=Msquare, label="End / governed handoff"]
    capture [shape=parallelogram, label="Capture demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    classify [shape=parallelogram, label="Normalize demand type", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    known [shape=diamond, label="Demand type known?"]
    choose_type [shape=hexagon, label="Choose demand type"]
    record_type [shape=parallelogram, label="Record chosen demand type", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    evidence [shape=parallelogram, label="Collect blast-radius evidence", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    policy [shape=parallelogram, label="Apply deterministic routing policy", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    route [shape=diamond, label="Select demand route"]
    stopped [shape=parallelogram, label="Record stopped demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    dispatch_bug [shape=parallelogram, label="Bug Fix", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    dispatch_feature [shape=parallelogram, label="Feature Delivery", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    dispatch_maintenance [shape=parallelogram, label="Maintenance", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    dispatch_security [shape=parallelogram, label="Security Remediation", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    dispatch_incident [shape=parallelogram, label="Incident Response", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    dispatch_discovery [shape=parallelogram, label="Discovery", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    start -> scaffold_guard
    scaffold_guard -> exit [label="Content pending"]
    scaffold_guard -> capture [condition="outcome=succeeded"]
    capture -> classify [condition="outcome=succeeded"]
    classify -> known [condition="outcome=succeeded"]
    known -> evidence [label="Known", condition="context.classification_known=true"]
    known -> choose_type [label="Unknown"]
    record_type -> evidence [condition="outcome=succeeded"]
    evidence -> policy [condition="outcome=succeeded"]
    policy -> route [condition="outcome=succeeded"]
    route -> choose_type [label="Missing / invalid type"]
    stopped -> exit [condition="outcome=succeeded"]
    route -> dispatch_bug [label="Bug", condition="context.demand_type=bug"]
    dispatch_bug -> exit [condition="outcome=succeeded"]
    choose_type -> record_type [label="[B] Bug"]
    route -> dispatch_feature [label="Feature", condition="context.demand_type=feature"]
    dispatch_feature -> exit [condition="outcome=succeeded"]
    choose_type -> record_type [label="[F] Feature"]
    route -> dispatch_maintenance [label="Maintenance", condition="context.demand_type=maintenance"]
    dispatch_maintenance -> exit [condition="outcome=succeeded"]
    choose_type -> record_type [label="[M] Maintenance"]
    route -> dispatch_security [label="Security", condition="context.demand_type=security"]
    dispatch_security -> exit [condition="outcome=succeeded"]
    choose_type -> record_type [label="[S] Security"]
    route -> dispatch_incident [label="Incident", condition="context.demand_type=incident"]
    dispatch_incident -> exit [condition="outcome=succeeded"]
    choose_type -> record_type [label="[I] Incident"]
    route -> dispatch_discovery [label="Discovery", condition="context.demand_type=discovery"]
    dispatch_discovery -> exit [condition="outcome=succeeded"]
    choose_type -> record_type [label="[D] Discovery"]
    choose_type -> stopped [label="[X] Stop"]
    capture -> exit [label="Failed / unanswered"]
    classify -> exit [label="Failed / unanswered"]
    choose_type -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record_type -> exit [label="Failed / unanswered"]
    evidence -> exit [label="Failed / unanswered"]
    policy -> exit [label="Failed / unanswered"]
    stopped -> exit [label="Failed / unanswered"]
    dispatch_bug -> exit [label="Failed / unanswered"]
    dispatch_feature -> exit [label="Failed / unanswered"]
    dispatch_maintenance -> exit [label="Failed / unanswered"]
    dispatch_security -> exit [label="Failed / unanswered"]
    dispatch_incident -> exit [label="Failed / unanswered"]
    dispatch_discovery -> exit [label="Failed / unanswered"]
}
