// Generated from definition.json. Content and execution bindings are pending.
// Human selections are not authenticated approval records by themselves.
digraph PrReviewLifecycle {
    graph [default_fidelity="full", default_max_retries=0, max_node_visits=3, on_failure="exit"]
    start [shape=Mdiamond, label="Start"]
    scaffold_guard [shape=parallelogram, label="Content pending — execution blocked", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", goal_gate=true, max_retries=0]
    exit [shape=Msquare, label="End / governed handoff"]
    event [shape=parallelogram, label="Receive event or scheduled scan", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    snapshot [shape=parallelogram, label="Read PR, checks and current revision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    terminal [shape=diamond, label="PR merged or closed?"]
    stop [shape=parallelogram, label="Stop monitoring closed PR", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    eligible [shape=diamond, label="Ready, green and eligible?"]
    claim [shape=parallelogram, label="Claim exact review identity", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    new_work [shape=diamond, label="New claimed revision?"]
    packet [shape=parallelogram, label="Build immutable review packet", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    current [shape=diamond, label="Revision and eligibility still current?"]
    review [shape=box, label="Review exact diff independently", backend="acp", acp.command="false", prompt="@../../stages/independent-review/prompt.md", timeout="12m", max_retries=0]
    validate [shape=parallelogram, label="Validate structured findings", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    save [shape=parallelogram, label="Save review before publication", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    publish_enabled [shape=diamond, label="COMMENT publication enabled?"]
    recheck [shape=parallelogram, label="Recheck exact head, base and checks", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    publish_current [shape=diamond, label="Revision and eligibility still current?"]
    comment [shape=parallelogram, label="Publish validated COMMENT once", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    wait [shape=parallelogram, label="Record waiting or unchanged state", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    start -> scaffold_guard
    scaffold_guard -> exit [label="Content pending"]
    scaffold_guard -> event [condition="outcome=succeeded"]
    event -> snapshot [condition="outcome=succeeded"]
    snapshot -> terminal [condition="outcome=succeeded"]
    terminal -> stop [label="Closed / merged", condition="context.pr_terminal=true"]
    terminal -> eligible [label="Open"]
    stop -> exit [condition="outcome=succeeded"]
    eligible -> claim [label="Ready and green", condition="context.review_eligible=true"]
    eligible -> wait [label="Draft / pending / blocked"]
    claim -> new_work [condition="outcome=succeeded"]
    new_work -> packet [label="New claim", condition="context.new_work=true"]
    new_work -> wait [label="Already claimed / saved"]
    packet -> current [condition="outcome=succeeded"]
    current -> review [label="Current", condition="context.revision_current=true"]
    current -> wait [label="Changed / blocked"]
    review -> validate [condition="outcome=succeeded"]
    validate -> save [condition="outcome=succeeded"]
    save -> publish_enabled [condition="outcome=succeeded"]
    publish_enabled -> recheck [label="Enabled", condition="context.publish_enabled=true"]
    publish_enabled -> wait [label="Save only"]
    recheck -> publish_current [condition="outcome=succeeded"]
    publish_current -> comment [label="Current and eligible", condition="context.revision_current=true"]
    publish_current -> wait [label="Changed / blocked"]
    comment -> wait [condition="outcome=succeeded"]
    wait -> exit [condition="outcome=succeeded"]
    event -> exit [label="Failed / unanswered"]
    snapshot -> exit [label="Failed / unanswered"]
    stop -> exit [label="Failed / unanswered"]
    claim -> exit [label="Failed / unanswered"]
    packet -> exit [label="Failed / unanswered"]
    review -> exit [label="Failed / unanswered"]
    validate -> exit [label="Failed / unanswered"]
    save -> exit [label="Failed / unanswered"]
    recheck -> exit [label="Failed / unanswered"]
    comment -> exit [label="Failed / unanswered"]
    wait -> exit [label="Failed / unanswered"]
}
