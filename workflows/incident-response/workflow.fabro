// Generated from definition.json. Content and execution bindings are pending.
// Human selections are not authenticated approval records by themselves.
digraph IncidentResponse {
    graph [default_fidelity="full", default_max_retries=0, max_node_visits=3, on_failure="exit"]
    start [shape=Mdiamond, label="Start"]
    scaffold_guard [shape=parallelogram, label="Content pending — execution blocked", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", goal_gate=true, max_retries=0]
    exit [shape=Msquare, label="End / governed handoff"]
    validate [shape=parallelogram, label="Validate demand and immutable inputs", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    triage [shape=box, label="Diagnose incident", backend="acp", acp.command="false", prompt="@../../stages/incident-triage/prompt.md", timeout="12m", max_retries=0]
    containment [shape=box, label="Propose containment and rollback", backend="acp", acp.command="false", prompt="@../../stages/containment-proposal/prompt.md", timeout="12m", max_retries=0]
    operational_authority [shape=hexagon, label="Authorize operational scope"]
    record_authority [shape=parallelogram, label="Validate and record human decision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    plan [shape=box, label="Plan bounded implementation", backend="acp", acp.command="false", prompt="@../../stages/plan/prompt.md", timeout="12m", max_retries=0]
    approve_plan [shape=hexagon, label="Approve approach and plan"]
    record_plan [shape=parallelogram, label="Validate and record human decision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    implement [shape=box, label="Implement approved change", backend="acp", acp.command="false", prompt="@../../stages/implement/prompt.md", timeout="12m", max_retries=0]
    verification [shape=parallelogram, label="Verify change", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    checks_passed [shape=diamond, label="Verification passed?"]
    reassess [shape=parallelogram, label="Reassess actual diff", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    scope_current [shape=diamond, label="Actual diff within approved scope?"]
    renew_scope [shape=hexagon, label="Renew approval for expanded scope"]
    record_renewal [shape=parallelogram, label="Validate and record human decision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    review [shape=parallelogram, label="Independent PR review", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    review_clear [shape=diamond, label="Independent review clear?"]
    merge_readiness [shape=parallelogram, label="Final approvals and GitHub merge readiness", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    rework [shape=parallelogram, label="Bounded repair / human escalation", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    stopped [shape=parallelogram, label="Record stopped demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    prepare_branch [shape=parallelogram, label="Prepare isolated branch and workspace", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    prepare_pr [shape=parallelogram, label="Prepare and optionally publish draft PR", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    pr_available [shape=diamond, label="PR exists and is ready for lifecycle tracking?"]
    waiting_pr [shape=parallelogram, label="Save PR proposal without publication", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    start -> scaffold_guard
    scaffold_guard -> exit [label="Content pending"]
    scaffold_guard -> validate [condition="outcome=succeeded"]
    validate -> triage [condition="outcome=succeeded"]
    triage -> containment [condition="outcome=succeeded"]
    containment -> operational_authority [condition="outcome=succeeded"]
    operational_authority -> record_authority [label="[A] Authorize scope"]
    operational_authority -> containment [label="[R] Revise proposal"]
    operational_authority -> stopped [label="[S] Stop"]
    record_authority -> plan [condition="outcome=succeeded"]
    plan -> approve_plan [condition="outcome=succeeded"]
    approve_plan -> record_plan [label="[A] Approve"]
    approve_plan -> plan [label="[R] Revise"]
    approve_plan -> stopped [label="[S] Stop"]
    record_plan -> prepare_branch [condition="outcome=succeeded"]
    implement -> verification [condition="outcome=succeeded"]
    verification -> checks_passed [condition="outcome=succeeded"]
    checks_passed -> reassess [label="Passed", condition="context.verification_passed=true"]
    checks_passed -> rework [label="Failed / missing evidence"]
    reassess -> scope_current [condition="outcome=succeeded"]
    scope_current -> prepare_pr [label="Scope current", condition="context.scope_current=true"]
    scope_current -> renew_scope [label="Broader / uncertain"]
    renew_scope -> record_renewal [label="[A] Approve revised scope"]
    renew_scope -> rework [label="[R] Revise"]
    renew_scope -> stopped [label="[S] Stop"]
    record_renewal -> reassess [condition="outcome=succeeded"]
    review -> review_clear [condition="outcome=succeeded"]
    review_clear -> merge_readiness [label="Clear", condition="context.review_clear=true"]
    review_clear -> rework [label="Findings / missing review"]
    merge_readiness -> exit [condition="outcome=succeeded"]
    rework -> exit [condition="outcome=succeeded"]
    stopped -> exit [condition="outcome=succeeded"]
    prepare_branch -> implement [condition="outcome=succeeded"]
    prepare_pr -> pr_available [condition="outcome=succeeded"]
    pr_available -> review [label="PR available", condition="context.pr_available=true"]
    pr_available -> waiting_pr [label="Proposal saved / publication disabled"]
    waiting_pr -> exit [condition="outcome=succeeded"]
    validate -> exit [label="Failed / unanswered"]
    triage -> exit [label="Failed / unanswered"]
    containment -> exit [label="Failed / unanswered"]
    operational_authority -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record_authority -> exit [label="Failed / unanswered"]
    plan -> exit [label="Failed / unanswered"]
    approve_plan -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record_plan -> exit [label="Failed / unanswered"]
    implement -> exit [label="Failed / unanswered"]
    verification -> exit [label="Failed / unanswered"]
    reassess -> exit [label="Failed / unanswered"]
    renew_scope -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record_renewal -> exit [label="Failed / unanswered"]
    review -> exit [label="Failed / unanswered"]
    merge_readiness -> exit [label="Failed / unanswered"]
    rework -> exit [label="Failed / unanswered"]
    stopped -> exit [label="Failed / unanswered"]
    prepare_branch -> exit [label="Failed / unanswered"]
    prepare_pr -> exit [label="Failed / unanswered"]
    waiting_pr -> exit [label="Failed / unanswered"]
}
