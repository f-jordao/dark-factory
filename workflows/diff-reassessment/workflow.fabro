// Generated from definition.json. Content and execution bindings are pending.
// Human selections are not authenticated approval records by themselves.
digraph DiffReassessment {
    graph [default_fidelity="full", default_max_retries=0, max_node_visits=3, on_failure="exit"]
    start [shape=Mdiamond, label="Start"]
    scaffold_guard [shape=parallelogram, label="Content pending — execution blocked", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", goal_gate=true, max_retries=0]
    exit [shape=Msquare, label="End / governed handoff"]
    diff [shape=parallelogram, label="Collect exact implementation diff", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    impact [shape=box, label="Explain reach and uncertainty", backend="acp", acp.command="false", prompt="@../../stages/analyze-impact/prompt.md", timeout="12m", max_retries=0]
    policy [shape=parallelogram, label="Apply deterministic routing policy", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    current [shape=diamond, label="Actual diff within approved scope?"]
    invalidate [shape=parallelogram, label="Invalidate approvals for changed scope", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    approve_scope [shape=hexagon, label="Confirm scope and acceptance"]
    record [shape=parallelogram, label="Validate and record human decision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    revise [shape=box, label="Plan bounded implementation", backend="acp", acp.command="false", prompt="@../../stages/plan/prompt.md", timeout="12m", max_retries=0]
    save [shape=parallelogram, label="Persist actual-diff assessment", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    stopped [shape=parallelogram, label="Record stopped demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    start -> scaffold_guard
    scaffold_guard -> exit [label="Content pending"]
    scaffold_guard -> diff [condition="outcome=succeeded"]
    diff -> impact [condition="outcome=succeeded"]
    impact -> policy [condition="outcome=succeeded"]
    policy -> current [condition="outcome=succeeded"]
    current -> save [label="Current", condition="context.scope_current=true"]
    current -> invalidate [label="Broader / uncertain / stale"]
    invalidate -> approve_scope [condition="outcome=succeeded"]
    approve_scope -> record [label="[A] Approve revised scope"]
    approve_scope -> revise [label="[R] Revise"]
    approve_scope -> stopped [label="[S] Stop"]
    revise -> approve_scope [condition="outcome=succeeded"]
    record -> save [condition="outcome=succeeded"]
    save -> exit [condition="outcome=succeeded"]
    stopped -> exit [condition="outcome=succeeded"]
    diff -> exit [label="Failed / unanswered"]
    impact -> exit [label="Failed / unanswered"]
    policy -> exit [label="Failed / unanswered"]
    invalidate -> exit [label="Failed / unanswered"]
    approve_scope -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record -> exit [label="Failed / unanswered"]
    revise -> exit [label="Failed / unanswered"]
    save -> exit [label="Failed / unanswered"]
    stopped -> exit [label="Failed / unanswered"]
}
