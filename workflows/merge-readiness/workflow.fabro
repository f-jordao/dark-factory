// Generated from definition.json. Content and execution bindings are pending.
// Human selections are not authenticated approval records by themselves.
digraph MergeReadiness {
    graph [default_fidelity="full", default_max_retries=0, max_node_visits=3, on_failure="exit"]
    start [shape=Mdiamond, label="Start"]
    scaffold_guard [shape=parallelogram, label="Content pending — execution blocked", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", goal_gate=true, max_retries=0]
    exit [shape=Msquare, label="End / governed handoff"]
    snapshot [shape=parallelogram, label="Read PR, checks and current revision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    preconditions [shape=diamond, label="Required merge evidence available?"]
    specialist_required [shape=diamond, label="Specialist acceptance required?"]
    specialist [shape=hexagon, label="Specialist accepts final revision"]
    record_specialist [shape=parallelogram, label="Validate and record human decision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    owner [shape=hexagon, label="Code owner approves final revision"]
    record_owner [shape=parallelogram, label="Validate and record human decision", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    recheck [shape=parallelogram, label="Recheck exact head, base and checks", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    current [shape=diamond, label="Required merge evidence available?"]
    handoff [shape=parallelogram, label="Record handoff to governed GitHub merge", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    wait [shape=parallelogram, label="Record waiting or unchanged state", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    rework [shape=parallelogram, label="Hand off to shared workflow", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    stopped [shape=parallelogram, label="Record stopped demand", script="printf '%s\\n' 'Workflow scaffold: stage content and trusted execution bindings are pending.'; exit 78", max_retries=0]
    start -> scaffold_guard
    scaffold_guard -> exit [label="Content pending"]
    scaffold_guard -> snapshot [condition="outcome=succeeded"]
    snapshot -> preconditions [condition="outcome=succeeded"]
    preconditions -> specialist_required [label="Evidence ready", condition="context.merge_evidence_ready=true"]
    preconditions -> wait [label="Missing / failed / unresolved"]
    specialist_required -> owner [label="Not required", condition="context.specialist_required=false"]
    specialist_required -> specialist [label="Required / unknown"]
    specialist -> record_specialist [label="[A] Accept final revision"]
    specialist -> rework [label="[R] Revise"]
    specialist -> stopped [label="[S] Stop"]
    record_specialist -> owner [condition="outcome=succeeded"]
    owner -> record_owner [label="[A] Approve final revision"]
    owner -> rework [label="[R] Revise"]
    owner -> stopped [label="[S] Stop"]
    record_owner -> recheck [condition="outcome=succeeded"]
    recheck -> current [condition="outcome=succeeded"]
    current -> handoff [label="Current, green and approved", condition="context.merge_ready=true"]
    current -> wait [label="Changed / approvals stale"]
    handoff -> exit [condition="outcome=succeeded"]
    wait -> exit [condition="outcome=succeeded"]
    rework -> exit [condition="outcome=succeeded"]
    stopped -> exit [condition="outcome=succeeded"]
    snapshot -> exit [label="Failed / unanswered"]
    specialist -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record_specialist -> exit [label="Failed / unanswered"]
    owner -> exit [label="Failed / unanswered", condition="outcome!=succeeded"]
    record_owner -> exit [label="Failed / unanswered"]
    recheck -> exit [label="Failed / unanswered"]
    handoff -> exit [label="Failed / unanswered"]
    wait -> exit [label="Failed / unanswered"]
    rework -> exit [label="Failed / unanswered"]
    stopped -> exit [label="Failed / unanswered"]
}
